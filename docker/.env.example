TZ=Asia/Seoul
DOCKER_USERNAME=your-dockerhub-id

# AI_PROVIDER 값: google-genai 또는 openai
AI_PROVIDER=google-genai

# 사용할 모델명 (선택사항, 비워두면 Provider별 기본값 사용)
# google-genai 기본값: gemini-3.6-flash  (다른 예: gemini-3.7-flash)
# openai 기본값: gpt-4o-mini              (다른 예: gpt-4o, gpt-4-turbo)
AI_MODEL=

GOOGLE_AI_API_KEY=
OPENAI_API_KEY=

POSTGRES_USER=agent_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=agent_db
REDIS_PASSWORD=CHANGE_ME

# 날씨 기능 (https://openweathermap.org 에서 무료 발급)
WEATHER_API_KEY=

# 뉴스 검색 기능 (https://newsapi.org 에서 무료 발급)
NEWS_API_KEY=